{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "vendicated-dev",
    "main": "@astrojs/cloudflare/entrypoints/server",
    "compatibility_date": "2026-05-05",
    "compatibility_flags": ["nodejs_compat"],
    "assets": {
        "binding": "ASSETS",
        "directory": "./dist"
    },
    "observability": {
        "enabled": true
    },
    "secrets": {
        "required": ["GITHUB_TOKEN"]
    }
}
