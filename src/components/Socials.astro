---
import Codeberg from "./Icons/Codeberg.astro";
import Email from "./Icons/Email.astro";
import GitHub from "./Icons/GitHub.astro";
import Mastodon from "./Icons/Mastodon.astro";
import PgpKey from "./Icons/PgpKey.astro";
import Telegram from "./Icons/Telegram.astro";
import Social from "./Social.astro";
---

<ul>
    <Social>
        <iframe
            id="discord-widget"
            title="User Embed"
            width="340"
            height="120"
            frameborder="0"
            scrolling="no"
            sandbox="allow-scripts"
            src="https://widgets.vendicated.dev/user?id=343383572805058560&theme=light&banner=true&full-banner=false&rounded-corners=false&discord-icon=true"
        ></iframe>
    </Social>
    <Social title="Github" text="Vendicated" href="https://github.com/Vendicated">
        <GitHub slot="icon" />
    </Social>
    <Social title="Codeberg" text="vee" href="https://codeberg.org/vee">
        <Codeberg slot="icon" />
    </Social>
    <Social title="Telegram" text="@vendyymachine" href="https://t.me/vendyymachine">
        <Telegram slot="icon" />
    </Social>
</ul>

<script>
    import { getCurrentTheme } from "../scripts/themeRuntime";

    const widget = document.querySelector("#discord-widget") as HTMLIFrameElement;

    const isDark = () => getCurrentTheme() === "dark";
    const getBackgroundColor = () => (isDark() ? "#1d1d2c" : "#faeeee");

    function postData(data: { command: string } & Record<string, unknown>) {
        widget.contentWindow!.postMessage(data, "*");
        console.log("Posted", data);
    }

    const setWidgetTheme = () => {
        postData({
            command: "setTheme",
            theme: getCurrentTheme()
        });
        postData({
            command: "setColors",
            backgroundColor: getBackgroundColor()
        });
    };

    let src = new URL(widget.src);
    src.searchParams.set("background-color", getBackgroundColor());
    if (isDark()) {
        src.searchParams.set("theme", "dark");
    }
    widget.src = src.toString();

    document.addEventListener("themechange", setWidgetTheme);
</script>

<style>
    ul {
        list-style: none;
        /* the user agent padding is insane */
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    iframe {
        box-shadow: 0px 0px 0px 1px var(--color);
        border-radius: 12px;
    }

    :global(.dark) iframe {
        box-shadow: none;
    }
</style>
